<? echo (
	$r->content_type('text/javascript');
	my $Object = eval( "new openprint::$param{type}($param{id});" );
	$Object->save({
		'shortname'	=>	$param{'shortname'},
		'longname'	=>	$param{'longname'},
		});
	my $html;
	$html .= sprintf(q`$('%s_shortname').value = '';`, $param{type}, $Object->shortname() );
	$html .= sprintf(q`$('%s_longname').value = '';`, $param{type}, $Object->longname() );
	return $html;
) ?>
	
