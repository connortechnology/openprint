<? echo (

	my $debug = 1;

	if ( ! $param{ServiceType} ) {
$log->warn("No servicetype in params in calc");
		return;
	} # end if

	my %specs = openprint::main_project::calc( $debug );
  if ($debug) {
    use Data::Dumper;
    $log->debug(Dumper(\%specs));
  }

	$param{callback} = 'cbFillResults' if ! $param{callback};
	my $json = JSON->new;
  $log->debug($json->encode( \%specs )) if $debug;
	return $json->encode( \%specs );
) ?>
