<? echo (
	my $debug = 0;
    # Not sure this is a good idea, but its neccessary for printing... why is it neccessary?
    $openprint::service::specs_cache{$param{ServiceIndex}} = \%param;
    my %specs = %param;
	$param{'method'} = 'calc' if ! $param{'method'};

   my $module = 'openprint::Estimating::'.$param{'ServiceType'};

    eval "require $module";
    $log->error("Error requiring $module: $@") if $@;
    if ( my $function = $module->can( $param{method} ) ) {
        $specs{'Status'} = $function->( $log, $dbh, $variable, @param{'ProjectIndex','ServiceIndex'}, \%specs );
	} else {
		$log->error("Cant do $param{method} for $module");
    } # end if

    my @results = ();
    my @vars = eval( 'openprint::Estimating::'.$param{'ServiceType'}.'::outputs( @param{\'ProjectIndex\', \'ServiceIndex\'}, \%specs )' );
$log->debug("vars @vars") if $debug;
    @vars = keys %specs if ! @vars;
$log->debug("vars @vars") if $debug;

    my @no_outputs = eval( 'return openprint::Estimating::'.$param{'ServiceType'}.'::no_outputs( @param{\'ProjectIndex\', \'ServiceIndex\'}, \%specs )' );
    @vars = sets::exclude( \@no_outputs, \@vars );

	foreach my $key ( @no_outputs ) {
		delete $specs{$key};
	} # end foreach
	if ( $debug ) {
		$log->debug("No outputs: @no_outputs");
		foreach my $key ( keys %specs ) {
			$log->debug("$key => $specs{$key}");
		} # end foreach
	} # end if debug
    foreach my $key ( @vars ) {
        if ( (exists $specs{$key}) and ($specs{$key} eq $param{$key}) ) {
			delete $specs{$key};
        } # end if
    } # end foreach

	$param{'callback'} = 'cbFillResults' if ! $param{'callback'};
	my $json = JSON->new;
	return 'var results = new Hash(' . $json->encode( \%specs ) . ");\n$param{'callback'}(results);";
) ?>
