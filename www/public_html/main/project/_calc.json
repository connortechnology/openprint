<? echo (
	my $debug = 0;
	my $Project = new openprint::Project( $param{'ProjectIndex'} );

	if ( $param{'action'} eq 'add_service' ) {
		foreach my $service_name ( ref $param{'service_name'} eq 'ARRAY' ? @{$param{'service_name'}} : $param{'service_name'} ) {
			$Project->add_service( $param{'service_name'} );
		} # end foreach service_name
	} elsif ( $param{'action'} eq 'del service' ) {
		my $services = $Project->services();
		foreach my $service_name ( ref $param{'service_name'} eq 'ARRAY' ? @{$param{'service_name'}} : $param{'service_name'} ) {
			next if ! $$services{$service_name}; 
			foreach ( @{$$services{$service_name}} ) {
				my $Service = new openprint::Project_Service( {'project_id'=>$$Project{'id'}, 'service_id'=>$_ } );
				$Service->delete();
			} # end foreach service_id
		} # end foreach service_name
	} # end if

    # Not sure this is a good idea, but it's neccessary for printing... why is it neccessary?
    $openprint::service::specs_cache{$param{ServiceIndex}} = \%param;
    my %specs = %param;
	$param{'method'} = 'calc' if ! $param{'method'};
    eval 'require openprint::Estimating::'.$param{'ServiceType'};
	$log->error("Error requiring openprint::Estimating::$param{'ServiceType'}: $@") if $@;
    eval(q/$specs{'Status'} = openprint::Estimating::/.$param{'ServiceType'}.'::'.$param{method}.'( $log, $dbh, $variable, @param{\'ProjectIndex\', \'ServiceIndex\'}, \%specs );');
	$log->error("Error requiring openprint::Estimating::$param{'ServiceType'}::calc in eval: $@") if $@;
    my @results = ();
    my @vars = sort eval( 'openprint::Estimating::'.$param{'ServiceType'}.'::outputs( @param{\'ProjectIndex\', \'ServiceIndex\'}, \%specs )' );
	$log->error("Error openprint::Estimating::$param{'ServiceType'}: $@") if $@;
	$log->debug("outputs @vars") if $debug;
	if ( ! @vars ) {
		@vars = keys %specs;
		$log->debug("no outputs, so using keys @vars") if $debug;
	} # end if

    my @no_outputs = sort eval( 'return openprint::Estimating::'.$param{'ServiceType'}.'::no_outputs( @param{\'ProjectIndex\', \'ServiceIndex\'}, \%specs )' );
    $log->error("Error openprint::Estimating::$param{'ServiceType'}::no_outputs: $@") if $@ or $debug;
    @vars = sets::exclude( \@no_outputs, \@vars );

	foreach my $key ( @no_outputs ) {
		delete $specs{$key};
	} # end foreach
	if ( $debug ) {
		$log->debug("No outputs: @no_outputs");
		foreach my $key ( keys %specs ) {
			$log->debug("$key => $specs{$key}");
		} # end foreach
	} # end if debug
    foreach my $key ( @vars ) {
        if ( (exists $specs{$key}) and ($specs{$key} eq $param{$key}) ) {
			delete $specs{$key};
        } # end if
    } # end foreach

	$param{'callback'} = 'cbFillResults' if ! $param{'callback'};
	my $json = JSON->new;
	return 'var results = new Hash(' . $json->encode( \%specs ) . ");\n$param{'callback'}(results);";
) ?>
