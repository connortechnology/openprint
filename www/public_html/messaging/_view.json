<? echo (
	return q`alert('`.$$variable{'error'}.q`');` if $$variable{'error'};
	if ( $param{'action'} eq 'Delete Message' ) {
		if ( ! sets::isin( $session{'user_id'}, [ $$variable{'Message'}->from_id(), map { $_->user_id() } $$variable{'Message'}->To() ]  ) ) {
			return qq`
				\$('message_$$variable{Message}{id}').remove();
			`;
		} # end if
	} elsif ( $param{'action'} eq 'reply' ) {
	} # end if
	return q`new Ajax.Updater( 'messages', '_messages.html', { parameters: { last_message_id: $('last_message_id').value }, insertion: Insertion.Bottom  } );`;
) ?>
