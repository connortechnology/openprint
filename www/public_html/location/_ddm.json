<? echo (
	# type should give the parent's type.  Also need parent's name to give the pattern for child elements.
	# Find children of the given location

	# parent_id may be empty, in which case, we get all chidlren of that type.
	my $Parent;

	if ( $param{parent_id} ) {
		$Parent = openprint::Location->find_one( id=>$param{parent_id} ) if $param{parent_id};
	} # end if
	my $type = $param{type} ? $param{type} : $$Parent{type};
$log->debug("Looking for $type parent name is $param{parent_element}");

	my $json = JSON->new;
	my $js = 'var ddm; var selected;';

	# I think we can only do one update at a time
if ( 0 ) {
	my $options = openprint::Location->dropdown(order=>'lower(name)', parent_id=>$$Parent{id} );	
        unshift @{$options}, 'All';
        unshift @{$options}, '';
        $js .= "
ddm = \$('$param{child_element}');
if ( ddm ) {
    selected = ddm.getValue();
    fill_ddm_from_array( ddm, " . $json->encode( $options ) . " );
    ddm_select_by_value( ddm, selected, 0 );
	ddm.onchange();
} // end if
";

} else {
	my ($ddm_name_start, $ddm_name_end) = $param{'parent_element'} =~ /^(.*)$type(.*)$/;
	# Goes through each child type, populating the dropdowns.
	while ( $type = openprint::Location->child_type($type) ) {
		my $options;
		if ( $Parent ) {
			$options = openprint::Location->dropdown( 'type' => $type, 'order'=>'lower(name)', 'parent_id'=>$$Parent{'id'} );
			$Parent = openprint::Location->find_one('parent_id'=>$$Parent{'id'}, type=>$type);
		} else {
			$options = openprint::Location->dropdown( 'type' => $type, 'order'=>'lower(name)' );
		} # end if

		my $ddm_name = $ddm_name_start.$type.$ddm_name_end;
	
		unshift @{$options}, 'All';
		unshift @{$options}, '';
		$js .= "
ddm = \$('$ddm_name');
if ( ddm ) {
	selected = ddm.getValue();
	fill_ddm_from_array( ddm, " . $json->encode( $options ) . " );	
	ddm_select_by_value( ddm, selected, 0 );
} // end if
";
	} # end while children type
}
$log->debug($js);
	return $js;
) ?>
