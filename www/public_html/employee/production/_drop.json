<? if ( $$variable{'changed'} ) ?>
<? echo ( 
	my @drops = sets::union( @{$$variable{'changed'}} );
$log->debug("Drops: @drops");
	$r->content_type('text/javascript');
	my $html = '';
	foreach my $id ( sort @drops ) {
		$html .= sprintf(q`new Ajax.Updater( 'ul%1$s', '_ul.html', { method: 'get', parameters: { ul_id: '%1$s' }, evalScripts: true } );`, $id );
	} # end foreach id
	return $html;
) ?>
<? endif ( $$variable{'changed'} ) ?>
