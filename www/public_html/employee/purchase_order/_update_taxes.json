<? echo ( 
	my $PO = $variable{PO};

	my $html;
	foreach my $Tax ( $PO->Taxes() ) {
$html .= sprintf('<div class="tax" id="tax-%1$d"><label>%2$s (<span id="tax_rate-%1$d">%3$d</span>%)<input type="checkbox" id="tax_charge-%1$d" name="tax_charge-%1$d" value="1" %6$s onclick="update_totals(this.form);" /></label><div class="amount">%4$s<span id="tax_amount-%1$d">%5$.2f</span></div></div>', $Tax->tax_id(),
                            $Tax->name(), $Tax->rate(), $PO->Currency()->symbol(), $Tax->amount(),
                            checked( $Tax->charge() ),
                            );
	} # end foreach Tax
	my @tax_ids = map { $_->tax_id() } $PO->Taxes();

	return qq`\$('Taxes').innerHTML = '$html';
tax_ids = [@tax_ids];
update_totals(\$('f1'));
`;
) ?>
