<? echo (
	if ( $variable{'error'} ) { 
		return qq`alert('$variable{error}');`;
	} # end if
	if ( $param{'func'} eq 'Del' ) {
		return qq`\$('#spec-$param{spec_id}').remove();`;
	} elsif ( $param{'func'} eq 'Add' ) {
	return qq` jQuery.get( '/product/_specification.html', { spec_id: $$variable{'Spec'}{'id'} }, function(content) { $('#specifications').append(content); } );`;
	} # end if
) ?>
