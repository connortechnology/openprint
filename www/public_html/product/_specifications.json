<? echo (
	if $variable{'error'} return qq`alert('$variable{error}');`;
	if ( $param{'func'} eq 'Del' ) {
		return qq`\$('spec-$param{spec_id}').remove();`;
	} elsif ( $param{'func'} eq 'Add' ) {
		my $Spec = $$variable{'Spec'};
return qq`
var e = new Element('tr');
\$('specifications').insert({
'bottom':'
<tr%1$s>
	<td class="name"><input type="text" id="spec_name-$$Spec{id}" name="spec_name-$$Spec{id}" value="$$Spec{name}" /></td>
	<td class="value"><input type="text" id="spec_value-$$Spec{id}" name="spec_value-$$Spec{id}" value="$$Spec{value}" /></td>
	<td class="buttons">%4$s</td>
</tr>'

});
`;		
	} # end if
) ?>
