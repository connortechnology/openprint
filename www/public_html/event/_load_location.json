<? echo (
	my $Location = new openprint::Location( $param{'location_id'} );
	my $city = ( ( $_ = $Location->ancestor('type'=>'city') ) ? $_->name() : '' );
	my $state = ( ( $_ = $Location->ancestor('type'=>['state','province']) ) ? $_->name() : '' );
	my $country = ( ( $_ = $Location->ancestor('type'=>'country') ) ? $_->name() : '' );

	return sprintf(q`
$('address').value = '%s';
$('postalcode').value = '%s';
$('city').value = '%s';
$('state').value = '%s';
$('country').value = '%s';
		`, map { $_ =~ s/'/\\'/g; $_;} ( $Location->address(), $Location->postalcode(), $city, $state, $country )
		);
) ?>
